    <div id="media-player" style="display:none; background-color: white; position: fixed; bottom: 0px; left:50%; transform: translateX(-50%);">
        <audio id="music-player" controls></audio>
        <video id="video-player" style="width: 100%; height: 100%;" controls></video>
        <button id="close-button" class="icon close" style="position: fixed; top: 0px; right: 0px;" onclick="stop()"></button>
        <script type="text/javascript">
            var mediaPlayer = document.getElementById("media-player");
            var musicPlayer = document.getElementById("music-player");
            var videoPlayer = document.getElementById("video-player");
            var closeButton = document.getElementById("close-button");
            function stop() {
                mediaPlayer.style.display = "none";
                musicPlayer.pause();
                musicPlayer.currentTime = 0;
                videoPlayer.pause();
                videoPlayer.currentTime = 0;
            }
            function read(uri) {
                window.open(uri);
            }
            function play(uri) {
                let isMusic = /\.(mp3|mpga|mid|midi)$/.test(uri);
                if (!isMusic) {
                    window.open(uri);
                    return;
                }
                // 关闭
                let ctrl0 = isMusic?videoPlayer:musicPlayer;
                ctrl0.pause();
                ctrl0.currentTime = 0;
                ctrl0.style.display = "none";
                // 播放
                let ctrl = isMusic ? musicPlayer: videoPlayer;
                ctrl.src = uri;
                ctrl.play();
                ctrl.style.display = "inline";
                mediaPlayer.style.display = "inline";
                if (!isMusic) {
                    mediaPlayer.style.width = "100%";
                    mediaPlayer.style.height = "100%";
                    closeButton.style.top = "0px";
                    closeButton.style.right = "0px";
                } else {
                    mediaPlayer.style.width = "auto";
                    mediaPlayer.style.height = "auto";
                    closeButton.style.top = "19px";
                    closeButton.style.right = "-16px";
                }
            }
        </script>
    </div>
